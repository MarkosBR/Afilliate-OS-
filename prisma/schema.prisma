generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum UserRole {
  USER
  ADMIN
}

enum ProductPlatform {
  HOTMART
  EDUZZ
  KIWIFY
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum LinkStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum PublicationPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  OTHER
}

enum PublicationStatus {
  PENDING
  SCHEDULED
  READY
  PUBLISHED
  FAILED
  CANCELLED
}

enum NotificationType {
  CONTENT_APPROVED
  CONTENT_REJECTED
  CONTENT_SCHEDULED
  PUBLICATION_FAILED
  PUBLICATION_PUBLISHED
}

enum IntegrationPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  WHATSAPP
  TELEGRAM
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
  ERROR
}

enum ContentKind {
  POST
  CAPTION
  AD
  PRODUCT_DESCRIPTION
  SCRIPT
}

enum ContentSource {
  MANUAL
  AI
}

enum AnalyticsEventType {
  CLICK
  CONVERSION
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  avatar         String?
  plan           Plan            @default(FREE)
  status         UserStatus      @default(ACTIVE)
  role           UserRole        @default(USER)
  lastLogin      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  affiliateLinks AffiliateLink[]
  campaigns      Campaign[]
  contents       Content[]
  publications   Publication[]
  notifications  Notification[]
  connectedAccounts ConnectedAccount[]
  analyticsEvents AnalyticsEvent[]
  adminLogs      AdminLog[]      @relation("AdminActor")
  targetedLogs   AdminLog[]      @relation("AdminTarget")

  @@index([email])
  @@index([status])
  @@index([role])
  @@index([plan])
  @@index([createdAt])
  @@map("users")
}

model Product {
  id             String           @id @default(cuid())
  userId         String
  name           String
  description    String?
  platform       ProductPlatform
  externalId     String?
  affiliateUrl   String
  commission     Decimal          @db.Decimal(8, 2)
  status         ProductStatus    @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateLinks  AffiliateLink[]
  campaigns       Campaign[]
  contents        Content[]
  analyticsEvents AnalyticsEvent[]

  @@index([userId])
  @@index([status])
  @@index([platform])
  @@index([createdAt])
  @@map("products")
}

model AffiliateLink {
  id         String     @id @default(cuid())
  userId     String
  productId  String
  campaignId String?
  name       String
  slug       String     @unique
  url        String
  status     LinkStatus @default(ACTIVE)
  clicks     Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contents   Content[]
  analyticsEvents AnalyticsEvent[]

  @@index([userId])
  @@index([productId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_links")
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  productId   String
  name        String
  description String?
  budget      Decimal        @db.Decimal(12, 2)
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateLinks  AffiliateLink[]
  contents        Content[]
  analyticsEvents AnalyticsEvent[]

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model Content {
  id          String        @id @default(cuid())
  userId      String
  productId   String?
  campaignId  String?
  linkId      String?
  title       String
  body        String?
  kind        ContentKind   @default(POST)
  channel     String?
  status      ContentStatus @default(DRAFT)
  source      ContentSource @default(MANUAL)
  generatedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  link          AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  publications  Publication[]

  @@index([userId])
  @@index([productId])
  @@index([campaignId])
  @@index([linkId])
  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@map("content")
}

model Publication {
  id                 String              @id @default(cuid())
  userId             String
  contentId          String
  connectedAccountId String?
  platform           PublicationPlatform
  scheduledAt        DateTime
  status             PublicationStatus   @default(SCHEDULED)
  publishedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  content            Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount?   @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contentId])
  @@index([connectedAccountId])
  @@index([status])
  @@index([scheduledAt])
  @@index([platform])
  @@index([userId, status, scheduledAt])
  @@index([contentId, platform, status])
  @@map("publications")
}

model ConnectedAccount {
  id                String               @id @default(cuid())
  userId            String
  platform          IntegrationPlatform
  externalAccountId String?
  displayName       String?
  status            ConnectionStatus     @default(DISCONNECTED)
  scopes            String[]             @default([])
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications      Publication[]

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([userId, status])
  @@map("connected_accounts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AnalyticsEvent {
  id         String              @id @default(cuid())
  userId     String
  productId  String?
  campaignId String?
  linkId     String?
  type         AnalyticsEventType
  revenue      Decimal             @default(0) @db.Decimal(12, 2)
  referrer     String?
  userAgent    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  fingerprint  String?
  createdAt    DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaign   Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  link       AffiliateLink?      @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([campaignId])
  @@index([linkId])
  @@index([type])
  @@index([createdAt])
  @@index([fingerprint])
  @@index([utmSource])
  @@index([utmMedium])
  @@index([utmCampaign])
  @@index([userId, type, createdAt])
  @@index([linkId, type, createdAt])
  @@index([campaignId, type, createdAt])
  @@map("analytics")
}

model AdminLog {
  id           String   @id @default(cuid())
  adminUserId  String
  action       String
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)
  target       User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_logs")
}
