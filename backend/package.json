{
  "name": "@affiliateos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bash ../scripts/with-env.sh tsx --test src/modules/health/health.test.ts src/modules/auth/auth.test.ts src/modules/phase1.isolation.test.ts src/modules/admin/admin.test.ts src/modules/tracking/tracking.test.ts src/modules/analytics/analytics.test.ts src/modules/ai/ai.prompts.test.ts src/modules/content/content.test.ts src/modules/publications/publications.test.ts src/modules/integrations/integrations.test.ts src/modules/integrations/youtube.test.ts src/modules/integrations/tiktok.test.ts src/modules/integrations/meta.test.ts",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate": "bash ../scripts/with-env.sh prisma migrate dev --schema ../prisma/schema.prisma",
    "prisma:migrate:deploy": "bash ../scripts/with-env.sh prisma migrate deploy --schema ../prisma/schema.prisma",
    "prisma:push": "bash ../scripts/with-env.sh prisma db push --schema ../prisma/schema.prisma",
    "prisma:studio": "bash ../scripts/with-env.sh prisma studio --schema ../prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "dependencies": {
    "@affiliateos/shared": "*",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
